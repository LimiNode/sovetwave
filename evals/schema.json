{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sovetwave evaluation suite",
  "type": "object",
  "required": ["version", "suite", "cases"],
  "properties": {
    "version": {"type": "string"},
    "suite": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt", "assertions"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "prompt": {"type": "string", "minLength": 1},
          "assertions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "checks": {
            "type": "object",
            "properties": {
              "contains_all": {"type": "array", "items": {"type": "string"}},
              "contains_any": {"type": "array", "items": {"type": "string"}},
              "not_contains": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
